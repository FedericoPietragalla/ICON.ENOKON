  <owl:Class rdf:about="http://example.org/enokon/wine#Secco">
    <rdfs:label xml:lang="it">Vino secco.</rdfs:label>
    <rdfs:comment xml:lang="it">zuccheri residui ∈ (-∞, 4.0] g/L. Indicazione di dolcezza UE: secco fino a 4 g/L (versione semplificata, senza la compensazione con l'acidità).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/enokon/wine#ProfiloZuccherino" />
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Class rdf:about="http://example.org/enokon/wine#Vino" />
