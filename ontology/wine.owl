            <owl:onProperty rdf:resource="http://example.org/enokon/wine#so2Totale" />
            <owl:someValuesFrom>
              <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
                <owl:withRestrictions rdf:parseType="Collection">
                  <rdf:Description>
                    <xsd:minExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">150.0</xsd:minExclusive>
                  </rdf:Description>
                </owl:withRestrictions>
              </rdfs:Datatype>
            </owl:someValuesFrom>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/enokon/wine#SO2TotaleOltre200">
    <rdfs:label xml:lang="it">SO2 totale sopra 200 mg/L.</rdfs:label>
    <rdfs:comment xml:lang="it">SO2 totale ∈ (200.0, +∞) mg/L. Ausiliaria: limite UE per i vini bianchi secchi.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/enokon/wine#ProfiloSO2Totale" />
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Class rdf:about="http://example.org/enokon/wine#Vino" />
          <owl:Restriction>
            <owl:onProperty rdf:resource="http://example.org/enokon/wine#so2Totale" />
            <owl:someValuesFrom>
              <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
                <owl:withRestrictions rdf:parseType="Collection">
                  <rdf:Description>
                    <xsd:minExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">200.0</xsd:minExclusive>
                  </rdf:Description>
                </owl:withRestrictions>
              </rdfs:Datatype>
            </owl:someValuesFrom>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/enokon/wine#SO2TotaleEccessiva">
    <rdfs:label xml:lang="it">SO2 totale oltre il limite di legge per la tipologia.</rdfs:label>
    <rdfs:comment xml:lang="it">(VinoRosso ∧ SO2TotaleOltre150) ∨ (VinoBianco ∧ SO2TotaleOltre200). Limiti UE sull'anidride solforosa totale per vini secchi: 150 mg/L (rossi) e 200 mg/L (bianchi). Versione semplificata: ignora i limiti più alti previsti per i vini con zuccheri residui &gt;= 5 g/L.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/enokon/wine#ProfiloEnologico" />
    <owl:equivalentClass>
      <owl:Class>
        <owl:unionOf rdf:parseType="Collection">
          <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
              <owl:Class rdf:about="http://example.org/enokon/wine#VinoRosso" />
              <owl:Class rdf:about="http://example.org/enokon/wine#SO2TotaleOltre150" />
            </owl:intersectionOf>
          </owl:Class>
          <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
              <owl:Class rdf:about="http://example.org/enokon/wine#VinoBianco" />
              <owl:Class rdf:about="http://example.org/enokon/wine#SO2TotaleOltre200" />
            </owl:intersectionOf>
          </owl:Class>
        </owl:unionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/enokon/wine#DensitaBassa">
