          <owl:Class rdf:about="http://example.org/enokon/wine#Vino" />
          <owl:Restriction>
            <owl:onProperty rdf:resource="http://example.org/enokon/wine#solfati" />
            <owl:someValuesFrom>
              <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
                <owl:withRestrictions rdf:parseType="Collection">
                  <rdf:Description>
                    <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.75</xsd:minInclusive>
                  </rdf:Description>
                </owl:withRestrictions>
              </rdfs:Datatype>
            </owl:someValuesFrom>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/enokon/wine#AlcolBasso">
    <rdfs:label xml:lang="it">Vino leggero.</rdfs:label>
    <rdfs:comment xml:lang="it">grado alcolico ∈ (-∞, 10.0) % vol. Convenzione: sotto 10 % vol.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/enokon/wine#ProfiloAlcolico" />
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Class rdf:about="http://example.org/enokon/wine#Vino" />
          <owl:Restriction>
            <owl:onProperty rdf:resource="http://example.org/enokon/wine#gradoAlcolico" />
            <owl:someValuesFrom>
              <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
                <owl:withRestrictions rdf:parseType="Collection">
                  <rdf:Description>
                    <xsd:maxExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">10.0</xsd:maxExclusive>
                  </rdf:Description>
                </owl:withRestrictions>
              </rdfs:Datatype>
            </owl:someValuesFrom>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/enokon/wine#AlcolMedio">
    <rdfs:label xml:lang="it">Vino di corpo medio.</rdfs:label>
    <rdfs:comment xml:lang="it">grado alcolico ∈ [10.0, 12.0) % vol. Convenzione: tra 10 e 12 % vol.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/enokon/wine#ProfiloAlcolico" />
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Class rdf:about="http://example.org/enokon/wine#Vino" />
          <owl:Restriction>
            <owl:onProperty rdf:resource="http://example.org/enokon/wine#gradoAlcolico" />
            <owl:someValuesFrom>
              <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
                <owl:withRestrictions rdf:parseType="Collection">
                  <rdf:Description>
                    <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">10.0</xsd:minInclusive>
                  </rdf:Description>
                  <rdf:Description>
                    <xsd:maxExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">12.0</xsd:maxExclusive>
                  </rdf:Description>
                </owl:withRestrictions>
              </rdfs:Datatype>
            </owl:someValuesFrom>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/enokon/wine#AlcolAlto">
    <rdfs:label xml:lang="it">Vino alcolico.</rdfs:label>
    <rdfs:comment xml:lang="it">grado alcolico ∈ [12.0, +∞) % vol. Convenzione: da 12 % vol, indice di uve molto mature.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/enokon/wine#ProfiloAlcolico" />
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Class rdf:about="http://example.org/enokon/wine#Vino" />
          <owl:Restriction>
            <owl:onProperty rdf:resource="http://example.org/enokon/wine#gradoAlcolico" />
            <owl:someValuesFrom>
              <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
                <owl:withRestrictions rdf:parseType="Collection">
                  <rdf:Description>
                    <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">12.0</xsd:minInclusive>
                  </rdf:Description>
                </owl:withRestrictions>
              </rdfs:Datatype>
            </owl:someValuesFrom>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/enokon/wine#RischioInstabilita">
    <rdfs:label xml:lang="it">Rischio di instabilità microbiologica/ossidativa.</rdfs:label>
    <rdfs:comment xml:lang="it">PHAlto ∧ SO2LiberaBassa. Un pH alto con SO2 libera bassa lascia il vino poco protetto (l'efficacia antimicrobica della solforosa cala al crescere del pH).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/enokon/wine#ProfiloEnologico" />
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Class rdf:about="http://example.org/enokon/wine#PHAlto" />
          <owl:Class rdf:about="http://example.org/enokon/wine#SO2LiberaBassa" />
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/enokon/wine#VinoDifettoso">
    <rdfs:label xml:lang="it">Vino con almeno un difetto analitico.</rdfs:label>
    <rdfs:comment xml:lang="it">AciditaVolatileElevata ∨ SO2TotaleEccessiva ∨ RischioInstabilita. Spunto acetico, eccesso di solforosa oppure rischio di instabilità.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/enokon/wine#ProfiloEnologico" />
    <owl:equivalentClass>
      <owl:Class>
        <owl:unionOf rdf:parseType="Collection">
          <owl:Class rdf:about="http://example.org/enokon/wine#AciditaVolatileElevata" />
          <owl:Class rdf:about="http://example.org/enokon/wine#SO2TotaleEccessiva" />
          <owl:Class rdf:about="http://example.org/enokon/wine#RischioInstabilita" />
        </owl:unionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/enokon/wine#VinoFresco">
    <rdfs:label xml:lang="it">Vino fresco e leggero.</rdfs:label>
    <rdfs:comment xml:lang="it">PHBasso ∧ (AlcolBasso ∨ AlcolMedio) ∧ AciditaVolatileBassa. Alta acidità (pH basso), alcol contenuto e assenza di spunto acetico: profilo tipico dei vini bianchi giovani e del vinho verde.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/enokon/wine#ProfiloEnologico" />
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Class rdf:about="http://example.org/enokon/wine#PHBasso" />
          <owl:Class>
            <owl:unionOf rdf:parseType="Collection">
              <owl:Class rdf:about="http://example.org/enokon/wine#AlcolBasso" />
              <owl:Class rdf:about="http://example.org/enokon/wine#AlcolMedio" />
            </owl:unionOf>
          </owl:Class>
          <owl:Class rdf:about="http://example.org/enokon/wine#AciditaVolatileBassa" />
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/enokon/wine#VinoEquilibrato">
    <rdfs:label xml:lang="it">Vino equilibrato.</rdfs:label>
    <rdfs:comment xml:lang="it">AlcolMedio ∧ AciditaVolatileBassa ∧ SO2LiberaAdeguata ∧ (PHBasso ∨ PHMedio). Alcol medio, acidità volatile bassa, protezione solforosa adeguata e pH usuale.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/enokon/wine#ProfiloEnologico" />
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Class rdf:about="http://example.org/enokon/wine#AlcolMedio" />
          <owl:Class rdf:about="http://example.org/enokon/wine#AciditaVolatileBassa" />
          <owl:Class rdf:about="http://example.org/enokon/wine#SO2LiberaAdeguata" />
          <owl:Class>
            <owl:unionOf rdf:parseType="Collection">
              <owl:Class rdf:about="http://example.org/enokon/wine#PHBasso" />
              <owl:Class rdf:about="http://example.org/enokon/wine#PHMedio" />
            </owl:unionOf>
          </owl:Class>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/enokon/wine#VinoMaturoEPulito">
    <rdfs:label xml:lang="it">Vino da uve mature e ben vinificato.</rdfs:label>
    <rdfs:comment xml:lang="it">AlcolAlto ∧ AciditaVolatileBassa. Grado alcolico alto (maturità delle uve) senza spunto acetico.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/enokon/wine#ProfiloEnologico" />
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Class rdf:about="http://example.org/enokon/wine#AlcolAlto" />
          <owl:Class rdf:about="http://example.org/enokon/wine#AciditaVolatileBassa" />
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/enokon/wine#QualitaBassa">
    <rdfs:label xml:lang="it">Vino di qualità bassa</rdfs:label>
    <rdfs:comment xml:lang="it">punteggioQualita ∈ [-∞, 5]</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/enokon/wine#QualitaVino" />
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Class rdf:about="http://example.org/enokon/wine#Vino" />
          <owl:Restriction>
            <owl:onProperty rdf:resource="http://example.org/enokon/wine#punteggioQualita" />
            <owl:someValuesFrom>
              <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer" />
                <owl:withRestrictions rdf:parseType="Collection">
                  <rdf:Description>
                    <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</xsd:maxInclusive>
                  </rdf:Description>
                </owl:withRestrictions>
              </rdfs:Datatype>
            </owl:someValuesFrom>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/enokon/wine#QualitaMedia">
    <rdfs:label xml:lang="it">Vino di qualità media</rdfs:label>
    <rdfs:comment xml:lang="it">punteggioQualita ∈ [6, 6]</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/enokon/wine#QualitaVino" />
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Class rdf:about="http://example.org/enokon/wine#Vino" />
          <owl:Restriction>
            <owl:onProperty rdf:resource="http://example.org/enokon/wine#punteggioQualita" />
            <owl:someValuesFrom>
              <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer" />
                <owl:withRestrictions rdf:parseType="Collection">
                  <rdf:Description>
                    <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</xsd:minInclusive>
                  </rdf:Description>
                  <rdf:Description>
                    <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</xsd:maxInclusive>
                  </rdf:Description>
                </owl:withRestrictions>
              </rdfs:Datatype>
            </owl:someValuesFrom>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/enokon/wine#QualitaAlta">
    <rdfs:label xml:lang="it">Vino di qualità alta</rdfs:label>
    <rdfs:comment xml:lang="it">punteggioQualita ∈ [7, +∞]</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/enokon/wine#QualitaVino" />
    <owl:equivalentClass>
