            <owl:someValuesFrom>
              <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
                <owl:withRestrictions rdf:parseType="Collection">
                  <rdf:Description>
                    <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">15.0</xsd:minInclusive>
                  </rdf:Description>
                  <rdf:Description>
                    <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">50.0</xsd:maxInclusive>
                  </rdf:Description>
                </owl:withRestrictions>
              </rdfs:Datatype>
            </owl:someValuesFrom>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/enokon/wine#SO2LiberaAlta">
    <rdfs:label xml:lang="it">SO2 libera eccessiva.</rdfs:label>
    <rdfs:comment xml:lang="it">SO2 libera ∈ (50.0, +∞) mg/L. Oltre ~50 mg/L la solforosa libera è percepibile all'olfatto (odore pungente).</rdfs:comment>
