                <owl:withRestrictions rdf:parseType="Collection">
                  <rdf:Description>
                    <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">4.0</xsd:maxInclusive>
                  </rdf:Description>
                </owl:withRestrictions>
              </rdfs:Datatype>
            </owl:someValuesFrom>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/enokon/wine#Abboccato">
    <rdfs:label xml:lang="it">Vino abboccato (semisecco).</rdfs:label>
    <rdfs:comment xml:lang="it">zuccheri residui ∈ (4.0, 12.0] g/L. Da 4 a 12 g/L (indicazione di dolcezza UE).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/enokon/wine#ProfiloZuccherino" />
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Class rdf:about="http://example.org/enokon/wine#Vino" />
          <owl:Restriction>
            <owl:onProperty rdf:resource="http://example.org/enokon/wine#zuccheriResidui" />
            <owl:someValuesFrom>
              <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
                <owl:withRestrictions rdf:parseType="Collection">
                  <rdf:Description>
                    <xsd:minExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">4.0</xsd:minExclusive>
                  </rdf:Description>
                  <rdf:Description>
                    <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">12.0</xsd:maxInclusive>
                  </rdf:Description>
                </owl:withRestrictions>
              </rdfs:Datatype>
            </owl:someValuesFrom>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/enokon/wine#Amabile">
    <rdfs:label xml:lang="it">Vino amabile o dolce.</rdfs:label>
    <rdfs:comment xml:lang="it">zuccheri residui ∈ (12.0, +∞) g/L. Oltre 12 g/L: le classi UE 'amabile' (12-45) e 'dolce' (&gt;45) sono unite perché i vini dolci sono poco rappresentati nel dataset.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/enokon/wine#ProfiloZuccherino" />
    <owl:equivalentClass>
