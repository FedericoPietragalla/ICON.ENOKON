              </rdfs:Datatype>
            </owl:someValuesFrom>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/enokon/wine#SO2LiberaAdeguata">
    <rdfs:label xml:lang="it">SO2 libera nell'intervallo di lavoro abituale.</rdfs:label>
    <rdfs:comment xml:lang="it">SO2 libera ∈ [15.0, 50.0] mg/L. Protezione adeguata senza note pungenti.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/enokon/wine#ProfiloSO2Libera" />
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
