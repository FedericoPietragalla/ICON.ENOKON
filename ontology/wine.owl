  <owl:Class rdf:about="http://example.org/enokon/wine#PHBasso">
    <rdfs:label xml:lang="it">pH basso: acidità elevata, vino fresco e stabile.</rdfs:label>
    <rdfs:comment xml:lang="it">pH ∈ (-∞, 3.2). Convenzione enologica.</rdfs:comment>
