  </owl:Class>
  <owl:Class rdf:about="http://example.org/enokon/wine#SO2LiberaBassa">
    <rdfs:label xml:lang="it">SO2 libera insufficiente.</rdfs:label>
    <rdfs:comment xml:lang="it">SO2 libera ∈ (-∞, 15.0) mg/L. Protezione scarsa da ossidazione e microrganismi (soglia di uso comune).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/enokon/wine#ProfiloSO2Libera" />
