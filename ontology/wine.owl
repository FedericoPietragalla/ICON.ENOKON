  <owl:Class rdf:about="http://example.org/enokon/wine#VinoRosso">
    <rdfs:label xml:lang="it">Vino rosso.</rdfs:label>
    <rdfs:comment xml:lang="it">tipoVino = "rosso". Tipologia indicata nel dataset.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/enokon/wine#TipoVino" />
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Class rdf:about="http://example.org/enokon/wine#Vino" />
          <owl:Restriction>
            <owl:onProperty rdf:resource="http://example.org/enokon/wine#tipoVino" />
            <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">rosso</owl:hasValue>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
