    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Class rdf:about="http://example.org/enokon/wine#Vino" />
          <owl:Restriction>
            <owl:onProperty rdf:resource="http://example.org/enokon/wine#so2Libera" />
            <owl:someValuesFrom>
              <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
                <owl:withRestrictions rdf:parseType="Collection">
                  <rdf:Description>
                    <xsd:minExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">50.0</xsd:minExclusive>
                  </rdf:Description>
                </owl:withRestrictions>
              </rdfs:Datatype>
            </owl:someValuesFrom>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/enokon/wine#SO2TotaleOltre150">
    <rdfs:label xml:lang="it">SO2 totale sopra 150 mg/L.</rdfs:label>
    <rdfs:comment xml:lang="it">SO2 totale ∈ (150.0, +∞) mg/L. Ausiliaria: limite UE per i vini rossi secchi.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/enokon/wine#ProfiloSO2Totale" />
    <owl:equivalentClass>
      <owl:Class>
